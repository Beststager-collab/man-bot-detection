   "source": [
    "import os\n",
    "\n",
    "from google.colab import drive\n",
    "drive.mount('/content/drive')\n",
    "\n",
    "PROJECT_DIR = '/content/drive/MyDrive/man-bot-detection'\n",
    "\n",
    "def human_size(num_bytes):\n",
    "    for unit in ['Б', 'КБ', 'МБ', 'ГБ']:\n",
    "        if num_bytes < 1024:\n",
    "            return f\"{num_bytes:.1f} {unit}\"\n",
    "        num_bytes /= 1024\n",
    "    return f\"{num_bytes:.1f} ТБ\"\n",
    "\n",
    "def dir_summary(path, max_list=5):\n",
    "    \"\"\"Повертає (існує?, кількість файлів, сумарний розмір, приклад файлів).\"\"\"\n",
    "    if not os.path.isdir(path):\n",
    "        return False, 0, 0, []\n",
    "    total_size = 0\n",
    "    file_count = 0\n",
    "    examples = []\n",
    "    for root, dirs, files in os.walk(path):\n",
    "        for f in files:\n",
    "            fp = os.path.join(root, f)\n",
    "            try:\n",
    "                total_size += os.path.getsize(fp)\n",
    "            except OSError:\n",
    "                continue\n",
    "            file_count += 1\n",
    "            if len(examples) < max_list:\n",
    "                examples.append(os.path.relpath(fp, path))\n",
    "    return True, file_count, total_size, examples\n",
    "\n",
    "print(f\"{'='*70}\\n📂 Перевірка: {PROJECT_DIR}\\n{'='*70}\")\n",
    "if not os.path.isdir(PROJECT_DIR):\n",
    "    print(\"❌ Папки man-bot-detection на Drive взагалі немає. Все доведеться качати з нуля.\")\n",
    "else:\n",
    "    print(\"✅ Папка проєкту існує.\")"
   ]
  },
